# Same URI the Aspirant server uses. Database name is aspirant-adda.
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=aspirant-adda

# Public origin for this site. Must not be aspirantadda.in or a subdomain of it.
PUBLIC_SITE_URL=http://localhost:3001

# Aspirant API, used server-side for phone OTP, likes, and comments.
API_URL=http://localhost:8000

# Where website events are stored. Defaults to MONGO_URI. Set this when posts are read
# from a local database but the analytics site reads another cluster.
ANALYTICS_MONGO_URI=
# Website analytics database. Events are written here, not into aspirant-adda.
ANALYTICS_DB_NAME=Adda50

# Mixpanel project token for device breakdown. Leave empty to skip Mixpanel.
NEXT_PUBLIC_MIXPANEL_TOKEN=
